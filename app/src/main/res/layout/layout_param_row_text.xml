<!-- #68 : ligne de la page Parameters dont la valeur est une SAISIE LIBRE (une adresse de serveur).
     Une adresse est trop longue pour la colonne de droite des autres lignes : elle prend donc toute
     la largeur, sous la description, et c'est le bouton Reset qui occupe cette colonne. Le bouton est
     estompe quand la valeur est deja celle d'origine ; un clic dans cet etat ne fait rien de mal, il
     rejoue simplement le defaut. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="com.gb.mybuoy.AppManager.OnTextCommitted" />

        <variable name="icon" type="android.graphics.drawable.Drawable" />
        <variable name="name" type="String" />
        <variable name="desc" type="String" />
        <variable name="value" type="String" />
        <variable name="isDefault" type="boolean" />
        <variable name="onTextCommitted" type="OnTextCommitted" />
        <variable name="onReset" type="android.view.View.OnClickListener" />

        <!-- Libelle du bouton de droite. Absent, c'est "Reset" : les lignes qui n'en demandent
             pas d'autre gardent leur bouton d'origine. -->
        <variable name="actionText" type="String" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="16dp"
                android:layout_marginRight="16dp"
                android:contentDescription="@{name}"
                android:src="@{icon}" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{name}"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{desc}"
                    android:textColor="#888888"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Meme largeur que le selecteur des lignes voisines : les colonnes de droite de la
                 page restent alignees d'une ligne a l'autre. -->
            <TextView
                android:layout_width="88dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginLeft="12dp"
                android:alpha="@{isDefault ? 0.35f : 1.0f}"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="end"
                android:onClick="@{onReset}"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@{actionText != null ? actionText : @string/param_reset}"
                android:textAlignment="viewEnd"
                android:textColor="#1565c0"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cale sur la colonne du texte (32 dp d'icone + 16 dp de marge) plutot que sur le bord :
             le champ se lit comme la suite de la description, pas comme un bloc separe. -->
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginLeft="48dp"
            android:layout_marginTop="8dp"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="1"
            android:textSize="14sp"
            app:entryText="@{value}"
            app:onTextCommitted="@{onTextCommitted}" />
    </LinearLayout>
</layout>
