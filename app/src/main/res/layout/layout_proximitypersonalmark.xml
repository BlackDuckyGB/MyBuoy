<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="personalMark"
            type="com.gb.mybuoy.PersonalMark" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context="com.gb.mybuoy.MainActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:onClick="@{() -> personalMark.switchSelected()}"
            android:onLongClick="@{() -> personalMark.editLongPress()}">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@{personalMark.bitmap}"
                app:srcCompat="@drawable/pixel"
                tools:srcCompat="@drawable/pixel" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:text="@{personalMark.title}"
                app:alarmedTitle="@{personalMark.alarmed}"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="20dp"
                app:autoSizeMinTextSize="10dp"
                app:autoSizeTextType="uniform"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:text="@{personalMark.distanceString}"
                app:autoSizeMaxTextSize="20dp"
                app:autoSizeMinTextSize="10dp"
                app:autoSizeTextType="uniform"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Badge de direction (rond façon burger), coin haut-gauche de l'icône, au premier plan. -->
        <ImageView
            android:id="@+id/imgDir"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@{personalMark.arrowBadge}"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>