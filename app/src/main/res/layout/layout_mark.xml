<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View"/>

        <variable
            name="mark"
            type="com.gb.mybuoy.PersonalMark" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_bg"
        tools:context="com.gb.mybuoy.MainActivity">

        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <!-- #65 : le titre "My mark" ne disait rien que le popup ne montrait deja ; sa ligne sert
                 maintenant au partage de la position. Bouton a GAUCHE : le coin haut droit est pris
                 par la croix de fermeture, posee en overlay sur tout le popup. Le glyphe de
                 ic_support_share est blanc (il est fait pour la pastille bleue de la page Support),
                 d'ou la teinte explicite, sans quoi il serait invisible sur ce fond clair. -->
            <ImageButton
                android:id="@+id/btnShareMark"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/ic_btn48_background"
                android:contentDescription="Share this position"
                android:onClick="@{() -> mark.share()}"
                android:scaleType="center"
                android:tint="#2196f3"
                app:srcCompat="@drawable/ic_support_share" />

            <!-- Saisie lat/lon : 3 includes (DD / DM / DMS), un seul visible selon le param CoordFmt.
                 #98 : hidden in Streamer mode, replaced by the read-only lines below. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="@{mark.streamerMode ? View.GONE : View.VISIBLE}">

                <include
                    layout="@layout/layout_mark_coord_dd"
                    app:mark="@{mark}" />

                <include
                    layout="@layout/layout_mark_coord_dm"
                    app:mark="@{mark}" />

                <include
                    layout="@layout/layout_mark_coord_dms"
                    app:mark="@{mark}" />
            </LinearLayout>

            <!-- #98 : Streamer mode, the shifted coordinates, read-only. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="@{mark.streamerMode ? View.VISIBLE : View.GONE}">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="Latitude" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:text="@{mark.latitudeString}" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="Longitude" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:text="@{mark.longitudeString}" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 64dp like the coordinate labels: the picture lines up with the N / E buttons. -->
                <TextView
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:text="Picture" />

                <Spinner
                    android:id="@+id/spMark"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:adapter="@{mark.marksAdapter}"
                    android:background="@drawable/spinner_bg"
                    android:selectedItemPosition="@={mark.bitmapPosition}" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:gravity="end"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnHere"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:textAllCaps="false"
                        android:text="⌖ HERE"
                        android:onClick="@{() -> mark.setToCurrentPosition()}" />

                    <!-- Altitude in whole metres; empty = unknown. The margins match the button
                         background insets (4dp sides, 6dp bottom) so the block lines up with the
                         visible edge of HERE; the top one also eats the field own top padding. -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_marginTop="-14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Altitude" />

                        <EditText
                            android:id="@+id/etAltitude"
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:inputType="numberSigned"
                            android:text="@={mark.altitudeEditString}" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="m" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Pulled up: the title field own top padding left a gap under the picture. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:text="Title" />


                <EditText
                    android:id="@+id/editTextTextPersonName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ems="10"
                    android:inputType="text"
                    android:text="@={mark.title}" />
            </LinearLayout>

            <!-- Share, Alarm et Select sur une seule ligne, en TROIS COLONNES DE MEME LARGEUR qui se
                 partagent toute la largeur du popup (layout_weight identique, layout_width a 0dp).
                 Dans chaque colonne le libelle est plaque a gauche et le switch a droite, pousse par
                 un Space pondere : les trois switches tombent donc au meme endroit de leur colonne,
                 et le dernier arrive au bord droit comme "Share" part du bord gauche. Un trait
                 separe les colonnes, sinon l'oeil rattache le switch du milieu au libelle suivant.
                 Tout tient sur UNE ligne volontairement : en paysage la hauteur du popup est
                 comptee, une ligne de plus ne passerait pas. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Share" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <Switch
                        android:id="@+id/swShared"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="@={mark.shared}" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginLeft="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_marginRight="6dp"
                    android:background="#CCCCCC" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alarm" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <Switch
                        android:id="@+id/swAlarmed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="@={mark.alarmed}" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginLeft="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_marginRight="6dp"
                    android:background="#CCCCCC" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <Switch
                        android:id="@+id/swSelected"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="@={mark.selected}" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delete"
                    android:visibility="@{mark.id > 0 ? View.VISIBLE: View.GONE}" />

                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save" />
            </LinearLayout>

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/relativeLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentRight="true"
                android:background="@drawable/ic_btn48_background"
                android:scaleType="center"
                app:srcCompat="@drawable/btn_cancel" />

        </RelativeLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>