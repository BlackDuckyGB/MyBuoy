<!-- Everything scrolls: there is no landscape variant, so the page must survive a short screen. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="viewsController"
            type="com.gb.mybuoy.ViewsController" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context="com.gb.mybuoy.MainActivity">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="24dp"
            android:text="Tides"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ScrollView
            android:id="@+id/svTides"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingLeft="24dp"
                android:paddingEnd="24dp"
                android:paddingRight="24dp"
                android:paddingBottom="24dp">

                <!-- Which place is on screen, and the way out of it. The readings below
                     carry no position of their own: tides read at a harbour fifty kilometres
                     away must never pass for the ones underfoot, so the place is always named,
                     the user's own position included. -->
                <LinearLayout
                    android:id="@+id/rowPlace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="6dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvPlace"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#1565C0"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Saint-Malo" />

                    <Button
                        android:id="@+id/btnPlaceSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginLeft="8dp"
                        android:minWidth="0dp"
                        android:textSize="12sp"
                        tools:text="Current position" />
                </LinearLayout>

                <!-- ============ grid missing ============ -->
                <LinearLayout
                    android:id="@+id/llNoTides"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="12dp"
                        android:lineSpacingExtra="4dp"
                        android:text="Tide prediction works offline, from a world tide model that is not bundled with the application. It is a separate download, kept alongside the offline maps."
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="16dp"
                        android:lineSpacingExtra="4dp"
                        android:text="Open the offline data page, find the entry named Tides (world), and start the download. Once it is installed this page shows the tides wherever you are, with no network."
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/btnGoToMaps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Open offline maps &amp; data" />
                </LinearLayout>

                <!-- ============ grid installed, but nothing here ============ -->
                <!-- The model stops short of the coast, so this is the ordinary answer
                     inland and inside narrow bays, not a failure. Rather than leave the
                     page empty, it offers the two ways out: the place whose tides were
                     read last, and a search for another one. The results are laid out as
                     plain rows instead of a ListView: the whole page already scrolls, and
                     a list inside a scroll fights it for the gesture. -->
                <LinearLayout
                    android:id="@+id/llNoHere"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvNoHere"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="14dp"
                        android:textSize="15sp"
                        tools:text="No tide data within 50 km of here." />

                    <!-- Offered only when it is not already what is on screen, so neither
                         button ever leads back to the page it was pressed from. -->
                    <Button
                        android:id="@+id/btnCurrentPlace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tides at my current position"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnLastPlace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        tools:text="Tides at Saint-Malo" />

                    <TextView
                        android:id="@+id/tvLookUp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="16dp"
                        android:textSize="15sp"
                        tools:text="Or look up a place: a town, a harbour, an island." />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="4dp">

                        <EditText
                            android:id="@+id/etTidePlace"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_marginRight="8dp"
                            android:layout_weight="1"
                            android:hint="Place name"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1" />

                        <Button
                            android:id="@+id/btnTidePlaceSearch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Search" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTidePlaceStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="6dp"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="Searching..." />

                    <LinearLayout
                        android:id="@+id/llTidePlaceResults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="4dp" />
                </LinearLayout>

                <!-- ============ waiting ============ -->
                <TextView
                    android:id="@+id/tvTidesWait"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="Preparing tides..."
                    android:textSize="15sp"
                    android:visibility="gone" />

                <!-- ============ tides ============ -->
                <LinearLayout
                    android:id="@+id/llTides"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- One grid for both orientations. The left column always holds the
                         readings, the legend and a clock; a second, larger clock stands in a
                         right column that only landscape has room for. Whichever clock does
                         not fit is hidden, so the two layouts never drift apart. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="4dp"
                            android:paddingBottom="2dp"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="Monday 28 September 2026 — 17:42" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingBottom="12dp">

                            <TextView
                                android:id="@+id/tvNowHeight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="15sp"
                                tools:text="Now: height 4.58 m" />

                            <ImageView
                                android:id="@+id/ivFishing"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginLeft="10dp"
                                android:layout_marginEnd="4dp"
                                android:layout_marginRight="4dp"
                                android:visibility="gone"
                                app:srcCompat="@drawable/ic_fishing" />

                            <TextView
                                android:id="@+id/tvFishing"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Good fishing"
                                android:textColor="#2E7D32"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </LinearLayout>

                        <!-- next tide -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingBottom="6dp">

                            <ImageView
                                android:id="@+id/ivTrend"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_marginEnd="10dp"
                                android:layout_marginRight="10dp"
                                app:srcCompat="@drawable/ic_tide_rising" />

                            <TextView
                                android:id="@+id/tvNext"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="High water 18:23 today — 4.85 m" />
                        </LinearLayout>

                        <!-- the one after -->
                        <TextView
                            android:id="@+id/tvThen"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="42dp"
                            android:paddingLeft="42dp"
                            android:paddingBottom="14dp"
                            android:textSize="15sp"
                            tools:text="then low water 00:44 tomorrow — 0.42 m" />

                            <!-- The text decides the height of the row; the clock beside it
                                 is aligned on the same floor. Giving this row a weight inside
                                 a column forced to the clock's height squeezed it instead,
                                 and the legend lost its last line. -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="bottom"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/bg_legend"
                                    android:orientation="vertical"
                                    android:paddingStart="10dp"
                                    android:paddingLeft="10dp"
                                    android:paddingTop="8dp"
                                    android:paddingEnd="12dp"
                                    android:paddingRight="12dp"
                                    android:paddingBottom="8dp">

                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                                        <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:paddingBottom="4dp">

                                        <View
                                            android:layout_width="18dp"
                                            android:layout_height="10dp"
                                            android:layout_marginEnd="8dp"
                                            android:layout_marginRight="8dp"
                                            android:background="#332196F3" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Water height"
                                            android:textSize="12sp" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:paddingBottom="4dp">

                                        <View
                                            android:layout_width="18dp"
                                            android:layout_height="10dp"
                                            android:layout_marginEnd="8dp"
                                            android:layout_marginRight="8dp"
                                            android:background="#3343A047" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Best fishing"
                                            android:textSize="12sp" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">

                                        <View
                                            android:layout_width="18dp"
                                            android:layout_height="10dp"
                                            android:layout_marginEnd="8dp"
                                            android:layout_marginRight="8dp"
                                            android:background="#FFD32F2F" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Now"
                                            android:textSize="12sp" />
                                    </LinearLayout>
                                </LinearLayout>

                                <!-- Pushes the clock to the right edge: the legend keeps its
                                     natural width on the left and this takes what is left. -->
                                <Space
                                    android:layout_width="0dp"
                                    android:layout_height="1dp"
                                    android:layout_weight="1" />

                                <com.gb.mybuoy.tides.TideClockView
                                    android:id="@+id/tideClockNarrow"
                                    android:layout_width="150dp"
                                    android:layout_height="150dp"
                                    android:layout_gravity="bottom"
                                    android:layout_marginStart="12dp"
                                    android:layout_marginLeft="12dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.gb.mybuoy.tides.TideClockView
                            android:id="@+id/tideClockWide"
                            android:layout_width="210dp"
                            android:layout_height="210dp"
                            android:layout_gravity="bottom"
                            android:layout_marginStart="16dp"
                            android:layout_marginLeft="16dp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <com.gb.mybuoy.tides.TideCurveView
                        android:id="@+id/tideCurve"
                        android:layout_width="match_parent"
                        android:layout_height="235dp" />

                    <TextView
                        android:id="@+id/tvDisclaimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:paddingTop="6dp"
                        android:text="EOT20 model. Not a substitute for the official tide tables of your area. Never rely on it alone to clear a hazard."
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="right"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/ic_btn48_background"
                android:scaleType="center"
                app:srcCompat="@drawable/btn_cancel" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
