<!-- #54 : une ligne de la liste des compas. Le bouton Edit ouvre la configuration ; il est rendu
     non focusable pour que le tap sur le reste de la ligne (= choisir ce compas) continue d'arriver
     jusqu'a la ListView. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <import type="com.gb.mybuoy.ViewsController" />
        <import type="android.view.View" />

        <variable
            name="compass"
            type="com.gb.mybuoy.Compass" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:descendantFocusability="blocksDescendants"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp"
            android:contentDescription="@{compass.name}"
            android:src="@drawable/ic_compass" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@{compass.name}"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_badge_inuse"
                android:paddingStart="8dp"
                android:paddingLeft="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingRight="8dp"
                android:paddingBottom="2dp"
                android:text="IN USE"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="@{compass.inUse ? View.VISIBLE : View.GONE}" />
        </LinearLayout>

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:onClick="@{(view) -> ViewsController.EditCompass(compass)}"
            android:text="Edit" />
    </LinearLayout>
</layout>
