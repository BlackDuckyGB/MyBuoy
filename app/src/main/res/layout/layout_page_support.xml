<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="appManager"
            type="com.gb.mybuoy.AppManager" />

        <variable
            name="viewsController"
            type="com.gb.mybuoy.ViewsController" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context="com.gb.mybuoy.MainActivity">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp"
            android:text="Support the development"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="8dp"
            android:background="@drawable/ic_btn48_background"
            android:scaleType="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/btn_cancel" />

        <!-- #37 : contenu de la page. Meme grammaire que la page Parameters : un en-tete de bloc
             par rubrique, puis du texte courant et/ou des lignes cliquables. Chaque ligne ouvre le
             navigateur (ou Telegram) sur la ressource annoncee sous son intitule. -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="32dp">

                <!-- #37 / #55 : bandeau d'identite. Le logo est l'icone de lancement, celle que
                     l'utilisateur reconnait sur son ecran d'accueil ; la version vient de
                     BuildConfig via appManager (format Majeur.Mineur.build de #20). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingLeft="24dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="24dp"
                    android:paddingRight="24dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginRight="20dp"
                        android:contentDescription="MyBuoy"
                        android:src="@mipmap/ic_launcher" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MyBuoy"
                            android:textColor="@android:color/black"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@{appManager.versionString}"
                            android:textColor="#1565c0"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- #55 : la mention n'est que declarative, le droit d'auteur naissant de la
                             creation. Elle designe le titulaire, la periode et la licence sous
                             laquelle l'application est distribuee. Ne couvre pas le tiers :
                             cf. THIRD-PARTY-NOTICES.md. -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="© 2021–2026 Golden-Block · AGPL-3.0"
                            android:textColor="#888888"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- #74 : incitation au partage, placee juste sous le bloc version/copyright.
                     Un seul bouton : ACTION_SEND ouvre la feuille de partage du systeme, qui liste
                     deja toutes les applications installees. Refaire six boutons ferait a la main
                     ce que l'OS fait mieux. La fleche de gauche est animee par ViewsController. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingLeft="16dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="16dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="No ads, no tracking, no budget. Just word of mouth."
                        android:textColor="@android:color/black"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgShareArrow"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginEnd="6dp"
                            android:layout_marginRight="6dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_share_arrow" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/btn_share_background"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:onClick="@{(view) -> viewsController.ShareApp()}"
                            android:orientation="horizontal"
                            android:paddingStart="20dp"
                            android:paddingLeft="20dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="24dp"
                            android:paddingRight="24dp"
                            android:paddingBottom="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginEnd="10dp"
                                android:layout_marginRight="10dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_support_share" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Share MyBuoy"
                                android:textColor="@android:color/white"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <include
                    layout="@layout/layout_param_block_header"
                    app:title='@{"What MyBuoy is"}' />

                <include
                    layout="@layout/layout_support_para"
                    app:text='@{"MyBuoy is a GPS application for hobbies, not a route guide: it computes no itinerary, reads no traffic and speaks no directions. Other applications do that far better, with means this project will never have.\n\nIt answers a different question. Not how to get there, but where you were and how to get back: where the last fish bit, where the car is parked, which corner of the wood had the chanterelles. Drop a mark, remove it, read your bearing and distance to it — on a map that keeps working with no network."}' />

                <!-- The channel link opens the video app when it is installed (it claims those
                     links), otherwise the default browser. -->
                <include
                    layout="@layout/layout_support_row"
                    app:desc='@{"Short videos showing MyBuoy in real use: dropping marks, finding your way back, and more."}'
                    app:icon="@{@drawable/ic_support_youtube}"
                    app:name='@{"Tutorial videos"}'
                    app:onClick='@{(view) -> viewsController.OpenUrl("https://www.youtube.com/@MyBuoyGB")}'
                    app:url='@{"youtube.com/@MyBuoyGB"}' />

                <include
                    layout="@layout/layout_param_block_header"
                    app:title='@{"Open source"}' />

                <include
                    layout="@layout/layout_support_para"
                    app:text='@{"MyBuoy is free software, released under the AGPL-3.0 licence. The whole source code is public: read it, build it, fork it."}' />

                <include
                    layout="@layout/layout_support_row"
                    app:desc='@{"Source code, releases and issue tracker."}'
                    app:icon="@{@drawable/ic_support_github}"
                    app:name='@{"The project on GitHub"}'
                    app:onClick='@{(view) -> viewsController.OpenUrl("https://github.com/BlackDuckyGB/MyBuoy")}'
                    app:url='@{"github.com/BlackDuckyGB/MyBuoy"}' />

                <include
                    layout="@layout/layout_param_block_header"
                    app:title='@{"Contribute"}' />

                <include
                    layout="@layout/layout_support_para"
                    app:text='@{"MyBuoy is written on evenings and weekends, and paid for out of one pocket. Anyone can help: with code, with field testing, or with money."}' />

                <include
                    layout="@layout/layout_support_row"
                    app:desc='@{"What the project needs, the ways to help, and what supporters get in return."}'
                    app:icon="@{@drawable/ic_menu_support}"
                    app:name='@{"Why, how, and what you get"}'
                    app:onClick='@{(view) -> viewsController.OpenUrl("https://github.com/BlackDuckyGB/MyBuoy/blob/main/SUPPORT.md")}'
                    app:url='@{"github.com/BlackDuckyGB/MyBuoy → SUPPORT.md"}' />

                <include
                    layout="@layout/layout_param_block_header"
                    app:title='@{"Where the money goes"}' />

                <include
                    layout="@layout/layout_support_para"
                    app:text='@{"Every contribution is spent on the application itself: the servers for the coming multi-user mode, building and hosting the offline maps, the computers and phones it is developed and checked on, the development tool licences — and the time that goes into it."}' />

                <include
                    layout="@layout/layout_support_row"
                    app:desc='@{"The full task list, with what each funded milestone paid for."}'
                    app:icon="@{@drawable/ic_support_roadmap}"
                    app:name='@{"Roadmap: done, in progress, next"}'
                    app:onClick='@{(view) -> viewsController.OpenUrl("https://github.com/BlackDuckyGB/MyBuoy/blob/main/ROADMAP.md")}'
                    app:url='@{"github.com/BlackDuckyGB/MyBuoy → ROADMAP.md"}' />

                <include
                    layout="@layout/layout_param_block_header"
                    app:title='@{"Stay updated"}' />

                <include
                    layout="@layout/layout_support_para"
                    app:text='@{"Every new release is announced on the Telegram channel, with the changelog and the download link. Subscribing is free and takes one tap."}' />

                <include
                    layout="@layout/layout_support_row"
                    app:desc='@{"Opens Telegram, or the web version if Telegram is not installed."}'
                    app:icon="@{@drawable/ic_support_telegram}"
                    app:name='@{"Telegram channel @MyBuoyByGB"}'
                    app:onClick='@{(view) -> viewsController.OpenTelegramChannel("MyBuoyByGB")}'
                    app:url='@{"t.me/MyBuoyByGB"}' />

                <include
                    layout="@layout/layout_param_block_header"
                    app:title='@{"Maps and data"}' />

                <include
                    layout="@layout/layout_support_para"
                    app:text='@{"The maps, the roads and the seamarks all come from OpenStreetMap, surveyed and kept up to date by hundreds of thousands of volunteers. MyBuoy would simply not exist without them."}' />

                <include
                    layout="@layout/layout_support_para"
                    app:text='@{"The tides are computed from EOT20, a global ocean tide model built from thirty years of satellite altimetry by researchers who chose to give it away. Knowing when the sea is high, anywhere, with no network at all, rests entirely on their work."}' />

                <include
                    layout="@layout/layout_support_row"
                    app:desc='@{"Map data © OpenStreetMap contributors, available under the Open Database Licence."}'
                    app:icon="@{@drawable/ic_menu_maps}"
                    app:name='@{"OpenStreetMap contributors"}'
                    app:onClick='@{(view) -> viewsController.OpenUrl("https://www.openstreetmap.org/copyright")}'
                    app:url='@{"openstreetmap.org/copyright"}' />

                <include
                    layout="@layout/layout_support_row"
                    app:desc='@{"Online map queries are answered by public Overpass servers, written and run by volunteers and paid for by donations."}'
                    app:icon="@{@drawable/ic_support_overpass}"
                    app:name='@{"The Overpass API"}'
                    app:onClick='@{(view) -> viewsController.OpenUrl("https://overpass-api.de/")}'
                    app:url='@{"overpass-api.de"}' />

                <include
                    layout="@layout/layout_support_row"
                    app:desc='@{"Tide predictions use the EOT20 ocean tide model by Hart-Davis et al. (DGFI-TUM), under CC BY 4.0, adapted here for offline use."}'
                    app:icon="@{@drawable/ic_support_eot20}"
                    app:name='@{"EOT20 tide model"}'
                    app:onClick='@{(view) -> viewsController.OpenUrl("https://doi.org/10.17882/79489")}'
                    app:url='@{"doi.org/10.17882/79489"}' />

                <include
                    layout="@layout/layout_support_row"
                    app:desc='@{"Sun and Moon positions come from ERFA, the freely licensed edition of the IAU Standards of Fundamental Astronomy, published by the NumFOCUS Foundation."}'
                    app:icon="@{@drawable/ic_support_erfa}"
                    app:name='@{"ERFA and IAU SOFA"}'
                    app:onClick='@{(view) -> viewsController.OpenUrl("https://github.com/liberfa/erfa")}'
                    app:url='@{"github.com/liberfa/erfa"}' />

                <include
                    layout="@layout/layout_param_block_header"
                    app:title='@{"Thanks"}' />

                <include
                    layout="@layout/layout_support_para"
                    app:text='@{"Thank you to everyone who cheered the project on, took it out on the water or on the trail to test it, wrote a line of code, helped fund it, or simply took the time to give it a try."}' />

                <include
                    layout="@layout/layout_support_para"
                    app:text='@{"And more particularly to:"}' />

                <!-- La liste est destinee a s'allonger a chaque contributeur : du texte courant qui
                     se replie tout seul, separe par des points medians, plutot qu'une ligne et une
                     icone par nom. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingLeft="24dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="24dp"
                    android:paddingRight="24dp"
                    android:paddingBottom="6dp"
                    android:lineSpacingExtra="6dp"
                    android:text="Claude&#160;the&#160;Good&#160;· Fab&#160;the&#160;Bard&#160;· Kiki&#160;the&#160;Strong&#160;· Uiuine&#160;the&#160;Golden&#160;Fry&#160;· Luce&#160;the&#160;Muse&#160;· Vicky&#160;Bikini&#160;&#x1F459;&#160;· Grapie&#160;Beckie"
                    android:textColor="@android:color/black"
                    android:textSize="15sp" />
            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
