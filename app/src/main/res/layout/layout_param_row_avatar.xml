<!-- Reusable Parameters-page row for one avatar category: the sprite preview (its resting frame,
     seen from the front) on the left, name + description, and the name of the current sprite on the
     right. Tapping the row opens the sprite picker. Include once per avatar category. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable name="preview" type="android.graphics.drawable.Drawable" />
        <variable name="name" type="String" />
        <variable name="desc" type="String" />
        <variable name="value" type="String" />
        <variable name="onClick" type="android.view.View.OnClickListener" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:onClick="@{onClick}"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp"
            android:contentDescription="@{name}"
            android:scaleType="centerInside"
            android:src="@{preview}" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{name}"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@{desc}"
                android:textColor="#888888"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Largeur bornee : un nom long ne doit pas manger la colonne de gauche. Il passe a la
             ligne, et si un mot ne peut pas etre coupe faute d'espace, il est tronque par des points
             de suspension. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginLeft="12dp"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="3"
            android:maxWidth="110dp"
            android:text="@{value}"
            android:textAlignment="viewEnd"
            android:textColor="#1565c0"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</layout>
